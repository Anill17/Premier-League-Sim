# =====================================================================
# Keep secrets and noise OUT of the Docker build context.
# Anything not needed at build time should be listed here.
# =====================================================================

# Secrets — env vars must come via `environment:` in docker-compose,
# not baked into image layers.
.env
.env.*
!.env.example

# Build outputs
bin/
*.exe
*.test
coverage.txt

# Git / editor / OS
.git
.gitignore
.idea/
.vscode/
.DS_Store
*.swp

# Project metadata not needed by the build
README.md
Makefile
docker-compose*.yml
.cursor/
agent-transcripts/

# Tests don't need to ship in the image (the binary is built statically)
# but Go's build tooling needs them at build time, so DON'T ignore *_test.go.
